        "glm-4.7-flash": { "name": "GLM-4.7-Flash", "limit": { "context": 32768, "output": 8192 } },
        "glm-4.7-flash-128k": { "name": "GLM-4.7-Flash (128k context)", "limit": { "context": 131072, "output": 8192 } }
